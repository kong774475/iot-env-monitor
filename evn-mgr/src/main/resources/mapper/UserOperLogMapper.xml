<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xjteam4.envMgr.mapper.UserOperLogMapper">

    <resultMap id="userOperLogMap" type="com.xjteam4.envMgr.domain.UserOperLogEntity">
        <result column="oper_id" property="operId" />
        <result column="oper_type" property="operType" />
        <result column="oper_desc" property="operDesc" />
        <result column="oper_time" property="operTime" />
        <association property="sysUser" javaType="com.xjteam4.envMgr.domain.SysUserEntity">
            <result column="user_id_2" property="userId" />
            <result column="user_name_2" property="userName" />
            <result column="user_pwd_2" property="userPwd" />
            <result column="nick_name_2" property="nickName" />
            <result column="user_phone_2" property="userPhone" />
        </association>
    </resultMap>

    <sql id="baseSql">
        SELECT
            user_oper_log.oper_id, user_oper_log.oper_type, user_oper_log.oper_desc, user_oper_log.oper_time, 
            sys_user_2.user_id user_id_2, sys_user_2.user_name user_name_2, sys_user_2.user_pwd user_pwd_2, sys_user_2.nick_name nick_name_2, sys_user_2.user_phone user_phone_2
        FROM user_oper_log
             JOIN sys_user sys_user_2 ON(user_oper_log.user_id = sys_user_2.user_id)
        WHERE 1 = 1 
    </sql>

    <sql id="condition">
        <if test="userOperLog.operId != null">
             and user_oper_log.oper_id = #{userOperLog.operId}
        </if>
        <if test="userOperLog.sysUser != null">
            <if test="userOperLog.sysUser.userId != null">
                 and sys_user_2.user_id = #{userOperLog.sysUser.userId}
            </if>
            <if test="userOperLog.sysUser.userName != null and userOperLog.sysUser.userName != ''">
                 and sys_user_2.user_name LIKE concat('%', #{userOperLog.sysUser.userName}, '%')
            </if>
            <if test="userOperLog.sysUser.userPwd != null and userOperLog.sysUser.userPwd != ''">
                 and sys_user_2.user_pwd LIKE concat('%', #{userOperLog.sysUser.userPwd}, '%')
            </if>
            <if test="userOperLog.sysUser.nickName != null and userOperLog.sysUser.nickName != ''">
                 and sys_user_2.nick_name LIKE concat('%', #{userOperLog.sysUser.nickName}, '%')
            </if>
            <if test="userOperLog.sysUser.userPhone != null and userOperLog.sysUser.userPhone != ''">
                 and sys_user_2.user_phone LIKE concat('%', #{userOperLog.sysUser.userPhone}, '%')
            </if>
        </if>
        <if test="userOperLog.operType != null">
             and user_oper_log.oper_type = #{userOperLog.operType}
        </if>
        <if test="userOperLog.operDesc != null and userOperLog.operDesc != ''">
             and user_oper_log.oper_desc LIKE concat('%', #{userOperLog.operDesc}, '%')
        </if>
        <if test="userOperLog.operTime != null and userOperLog.operTime != ''">
             and user_oper_log.oper_time LIKE concat('%', #{userOperLog.operTime}, '%')
        </if>
    </sql>

    <select id="queryById" resultMap="userOperLogMap">
        <include refid="baseSql"></include>
        AND user_oper_log.oper_id = #{operId}
    </select>

    <select id="queryAllByLimit" resultMap="userOperLogMap">
        <include refid="baseSql"></include>
        <include refid="condition"></include>
        order by oper_id desc
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <select id="count" resultType="java.lang.Long">
        select count(1)
        from (
        <include refid="baseSql"></include>
        <include refid="condition"></include> ) t
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="operId">
        insert into user_oper_log(user_id, oper_type, oper_desc, oper_time)
        values(#{sysUser.userId}, #{operType}, #{operDesc}, #{operTime})
    </insert>

    <update id="update">
        update user_oper_log
        <set>
            <if test="sysUser != null and sysUser.userId != null">
                user_id = #{sysUser.userId},
            </if>
            <if test="operType != null">
                oper_type = #{operType},
            </if>
            <if test="operDesc != null and operDesc != ''">
                oper_desc = #{operDesc},
            </if>
            <if test="operTime != null and operTime != ''">
                oper_time = #{operTime},
            </if>
        </set>
        WHERE oper_id = #{operId}
    </update>

    <delete id="deleteById">
        DELETE FROM user_oper_log WHERE oper_id = #{operId}
    </delete>

    <!-- 全新独立查询：时间区间、操作类型、操作人员昵称模糊、自定义条数 -->
    <!-- 独立多条件时间条数查询，无语法错误版本 -->
    <select id="queryLogByTimeAndLimit" resultMap="userOperLogMap">
        <include refid="baseSql"/>
        <!-- 删掉这里的 WHERE 1=1 !!! -->
        <if test="startTime != null and startTime != ''">
            AND user_oper_log.oper_time &gt;= #{startTime}
        </if>
        <if test="endTime != null and endTime != ''">
            AND user_oper_log.oper_time &lt;= #{endTime}
        </if>
        <if test="operType != null">
            AND user_oper_log.oper_type = #{operType}
        </if>
        <if test="nickName != null and nickName != ''">
            AND sys_user_2.nick_name LIKE concat('%', #{nickName}, '%')
        </if>
        ORDER BY user_oper_log.oper_id DESC
        LIMIT 0, #{limitNum}
    </select>

    <!-- 配套统计总数 -->
    <select id="countLogByTime" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM user_oper_log
        JOIN sys_user sys_user_2 ON(user_oper_log.user_id = sys_user_2.user_id)
        <!-- 删掉 WHERE 1=1 -->
        <if test="startTime != null and startTime != ''">
            AND user_oper_log.oper_time &gt;= #{startTime}
        </if>
        <if test="endTime != null and endTime != ''">
            AND user_oper_log.oper_time &lt;= #{endTime}
        </if>
        <if test="operType != null">
            AND user_oper_log.oper_type = #{operType}
        </if>
        <if test="nickName != null and nickName != ''">
            AND sys_user_2.nick_name LIKE concat('%', #{nickName}, '%')
        </if>
    </select>

</mapper>

